# Copia este archivo como .env y reemplaza los valores de ejemplo.
# Ejecuta main.py desde la carpeta eliminador_correos/.

# Servidor IMAP de tu proveedor. Ejemplos: imap.gmail.com, outlook.office365.com
IMAP_HOST=imap.example.com
# Puerto IMAP seguro (SSL). Normalmente es 993.
IMAP_PUERTO=993

# CSV con las cuentas, relativo a eliminador_correos/ o una ruta absoluta.
# Copia cuentas.example.csv como cuentas.csv y completa sus credenciales.
CUENTAS_CSV=cuentas.csv

# Configura al menos uno de los cuatro filtros para evitar una búsqueda ALL.
# Para indicar varios valores, sepáralos con punto y coma (;).
# Ejemplo: BORRAR_REMITENTE=promo@example.com;spam@example.com
BORRAR_REMITENTE=
# Ejemplo: BORRAR_ASUNTO=Oferta;Publicidad
BORRAR_ASUNTO=

# Fechas opcionales en formato AAAA-MM-DD.
# BORRAR_HASTA incluye ese día.
# Ejemplo: BORRAR_DESDE=2024-01-01
BORRAR_DESDE=
# Ejemplo: BORRAR_HASTA=2024-12-31
BORRAR_HASTA=
